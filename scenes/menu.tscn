[node name="RulesText" type="RichTextLabel" parent="CanvasLayer/RulesPopup/Margin/VBox" unique_id=541810920]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = " 1. LOS DADOS: Al iniciar tu turno se tiran automáticamente 3 dados  con números del 1 al 8
2. ARMA TU CUENTA: Combina los 3 dados usando los signos + - * / ( ) para calcular un número libre del tablero (del 1 al 50). Ejemplo: Si sacas 3, 5 y 8, puedes armar: ( 8 - 5 ) * 3 = 9
3. CONQUISTA TU CASILLA: Si el resultado es un número entero exacto y está libre, presiona Confirmar para marcarlo con tu ficha (Azul X o Naranja O).
4. ¡GANA LA PARTIDA!: Sé el primero en alinear 3 casillas seguidas (horizontal, vertical o diagonal) para ganar."

